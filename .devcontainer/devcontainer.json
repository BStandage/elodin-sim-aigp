{
  "name": "elodin-sim-aigp",
  "dockerComposeFile": ["../docker-compose.yml"],
  "service": "sim",
  "workspaceFolder": "/work/elodin-sim-aigp",
  "overrideCommand": true,
  "forwardPorts": [2240],
  "customizations": {
